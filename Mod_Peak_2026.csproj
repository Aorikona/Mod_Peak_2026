<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Mod_Peak_2026</RootNamespace>
    <AssemblyName>Mod_Peak_2026</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\Debug\</OutputPath>

    <!-- Désactive la génération auto pour utiliser Properties/AssemblyInfo.cs sans conflit -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Répertoires d'installation locale du jeu (détection auto selon la machine) -->
  <PropertyGroup>
    <PeakManagedDir Condition="Exists('F:\Steam\steamapps\common\PEAK\PEAK_Data\Managed')">F:\Steam\steamapps\common\PEAK\PEAK_Data\Managed</PeakManagedDir>
    <PeakManagedDir Condition="'$(PeakManagedDir)' == '' AND Exists('K:\SteamLibrary\steamapps\common\PEAK\PEAK_Data\Managed')">K:\SteamLibrary\steamapps\common\PEAK\PEAK_Data\Managed</PeakManagedDir>
    <BepInExDir Condition="Exists('F:\Steam\steamapps\common\PEAK\BepInEx\core')">F:\Steam\steamapps\common\PEAK\BepInEx\core</BepInExDir>
    <BepInExDir Condition="'$(BepInExDir)' == '' AND Exists('K:\SteamLibrary\steamapps\common\PEAK\BepInEx\core')">K:\SteamLibrary\steamapps\common\PEAK\BepInEx\core</BepInExDir>
  </PropertyGroup>

  <!-- Références Moteur Unity & Modules UI -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(PeakManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(PeakManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityUIExtensions">
      <HintPath>$(PeakManagedDir)\UnityUIExtensions.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(PeakManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Code original de PEAK & Réseau -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(PeakManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(PeakManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(PeakManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(PeakManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Zorro.Core.Runtime">
      <HintPath>$(PeakManagedDir)\Zorro.Core.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- BepInEx / Harmony -->
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclusion des dossiers temporaires/tests pour supprimer les définitions en double -->
  <ItemGroup>
    <Compile Remove="PeakClassMod\**" />
    <Compile Remove="build\**" />
    <Compile Remove="tests\**" />
    <Compile Remove="Class1Test.cs" />
    <Compile Remove="Class1.cs" />
  </ItemGroup>

  <!-- Ressources UI embarquées -->
  <ItemGroup>
    <EmbeddedResource Include="assets\image\HatSign.png" Condition="Exists('assets\image\HatSign.png')" />
  </ItemGroup>

  <!-- Packages BCL -->
  <ItemGroup>
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Animation (Résout Animator) -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Entrées utilisateur (Résout Input) -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.InputModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Web & Téléchargement (Résout UnityWebRequest, DownloadHandlerTexture, UnityWebRequestTexture) -->
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.UnityWebRequestTextureModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>